{
  "manifest_version": 3,
  "name": "Group Tabs to the Right",
  "version": "1.5.1",
  "version_name": "1.5-MandateUpdate",
  "description": "Adds all tabs to the right of the current tab to a tab group via button press or Alt-Shift-G.",
  "permissions": ["tabGroups"],
  "action": {
    "default_title": "Group tabs to the right",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" }
    }
  }
}
